From: Active, Frozen
To: Other, SameAsFrom
Amount: BelowBalance, ExactBalance, AboveBalance
Currency: MNT, USD
Balance: Sufficient, Exact, Insufficient
DailyLimit: Available, Reached

IF [From] = "Frozen" THEN [To] = "Other" AND [Amount] = "BelowBalance" AND [Balance] = "Sufficient" AND [DailyLimit] = "Available";
IF [To] = "SameAsFrom" THEN [From] = "Active" AND [Amount] = "BelowBalance" AND [Balance] = "Sufficient" AND [DailyLimit] = "Available";
IF [Amount] = "BelowBalance" THEN [Balance] = "Sufficient";
IF [Amount] = "ExactBalance" THEN [Balance] = "Exact";
IF [Amount] = "AboveBalance" THEN [From] = "Active" AND [To] = "Other" AND [Balance] = "Insufficient" AND [DailyLimit] = "Available";
IF [DailyLimit] = "Reached" THEN [From] = "Active" AND [To] = "Other" AND [Amount] = "BelowBalance" AND [Balance] = "Sufficient";
